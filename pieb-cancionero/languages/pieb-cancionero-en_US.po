msgid "Les llega a los administradores del cancionero y al correo de administración de la web (%s), con la canción, sus archivos, quién la borró y cuándo. Los borrados seguidos llegan juntos en un solo correo, un minuto después."
msgstr "It goes to the songbook administrators and to the site’s admin email (%s), with the song, its files, who deleted it and when. Deletions made in a row arrive together in a single email, a minute later."

#. %s: título de la canción borrada
#: includes/avisos.php:173
#, php-format
msgid "Se ha borrado «%s» del cancionero"
msgstr "“%s” was deleted from the songbook"

#. %d: número de canciones borradas
#: includes/avisos.php:176
#, php-format
msgid "Se ha borrado %d canción del cancionero"
msgid_plural "Se han borrado %d canciones del cancionero"
msgstr[0] "%d song was deleted from the songbook"
msgstr[1] "%d songs were deleted from the songbook"

#. %d: número de canciones borradas
#: includes/avisos.php:182
#, php-format
msgid "%d canción borrada"
msgid_plural "%d canciones borradas"
msgstr[0] "%d song deleted"
msgstr[1] "%d songs deleted"

#. 1: nombre de quien borró la canción, 2: su correo electrónico, 3: fecha y hora del borrado
#: includes/avisos.php:186
#, php-format
msgid "Borrada por %1$s (%2$s) el %3$s"
msgstr "Deleted by %1$s (%2$s) on %3$s"

#. %s: lista de nombres de archivo separados por comas
#: includes/avisos.php:188
#, php-format
msgid "Archivos: %s"
msgstr "Files: %s"

#: includes/avisos.php:189
msgid "Sin archivos"
msgstr "No files"

#. %d: días que se conservan las canciones borradas en la papelera
#: includes/avisos.php:195
#, php-format
msgid "Está en la papelera: se puede recuperar durante %d día desde Ajustes y equipo → Papelera."
msgid_plural "Está en la papelera: se puede recuperar durante %d días desde Ajustes y equipo → Papelera."
msgstr[0] "It is in the trash: it can be restored for %d day from Settings and team → Trash."
msgstr[1] "It is in the trash: it can be restored for %d days from Settings and team → Trash."

#. %d: días que se conservan las canciones borradas en la papelera
#: includes/avisos.php:201
#, php-format
msgid "Están en la papelera: se pueden recuperar durante %d día desde Ajustes y equipo → Papelera."
msgid_plural "Están en la papelera: se pueden recuperar durante %d días desde Ajustes y equipo → Papelera."
msgstr[0] "They are in the trash: they can be restored for %d day from Settings and team → Trash."
msgstr[1] "They are in the trash: they can be restored for %d days from Settings and team → Trash."

#: includes/avisos.php:205
msgid "Está en la papelera hasta que un administrador la elimine."
msgstr "It is in the trash until an administrator deletes it."

#: includes/avisos.php:207
msgid "Están en la papelera hasta que un administrador las elimine."
msgstr "They are in the trash until an administrator deletes them."

#: includes/avisos.php:209
msgid "Abrir la papelera"
msgstr "Open the trash"

#. %s: nombre del cancionero
#: includes/avisos.php:211
#, php-format
msgid "Recibes este aviso porque administras el cancionero «%s». Se puede desactivar en Ajustes y equipo → General."
msgstr "You’re receiving this alert because you manage the songbook “%s”. It can be turned off in Settings and team → General."

#. %d: número de canciones borradas que no se detallan en el correo
#: includes/avisos.php:218
#, php-format
msgid "Y %d canción más."
msgid_plural "Y %d canciones más."
msgstr[0] "And %d more song."
msgstr[1] "And %d more songs."

